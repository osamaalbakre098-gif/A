{
  "name": "madar",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "build:static": "TARGET=gallery vite build -c vite.static.config.ts && TARGET=app vite build -c vite.static.config.ts && TARGET=heute vite build -c vite.static.config.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint . && tsx scripts/lint-css.ts",
    "format": "prettier --write .",
    "a11y": "playwright test gallery --project=chromium",
    "a11y:contrast": "tsx scripts/contrast.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@tanstack/react-router": "^1.170.46",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "i18next": "^27.1.5",
    "i18next-icu": "^2.7.0",
    "intl-messageformat": "^12.2.0",
    "lucide-react": "^1.74.0",
    "minisearch": "^7.2.0",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.2",
    "tesseract.js": "^7.0.0",
    "ts-fsrs": "^6.0.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.10.2",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "pngjs": "^7.0.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0",
